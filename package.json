{
  "name": "recepcion-ia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema Recepcion-IA multicanal: un nucleo conversacional compartido, dos adaptadores de canal (WhatsApp y voz).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:adversarial": "vitest run tests/adversarial",
    "kg": "tsx kg/cli.ts",
    "kg:extraer": "tsx kg/extraer.ts",
    "kg:verificar": "tsx kg/cli.ts verificar",
    "kg:mcp": "tsx kg/mcp.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "wer": "tsx scripts/wer.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/supabase-js": "^2.110.8",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "googleapis": "^173.0.0",
    "libphonenumber-js": "^1.13.9",
    "p-retry": "^8.0.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
